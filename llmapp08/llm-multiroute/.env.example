OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=your_ollama_key_here
OLLAMA_TEMPERATURE=0.7

OLLAMA_MODEL_CLASSIFY=gemma4:31b
OLLAMA_MODEL_SENTIMENT=glm-5.2
OLLAMA_MODEL_SUMMARIZE=mistral-large-3:675b
OLLAMA_MODEL_INTENT=minimax-m3

LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxx
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional: set to true to reject (HTTP 400) instead of log-only for each category.
# GUARDRAILS_BLOCK_PROMPT_INJECTION=true
# GUARDRAILS_BLOCK_HARMFUL_CONTENT=true
# GUARDRAILS_BLOCK_SECRETS=true
